{
  "info": {
    "name": "Acordes del Barrio - API",
    "description": "Colección de pruebas. Ejecutar en orden con el Collection Runner (o Newman). Requiere la API en {{baseUrl}} con datos semilla.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "encargadoId",
      "value": "1"
    },
    {
      "key": "estudianteId",
      "value": "2"
    },
    {
      "key": "estudiante2Id",
      "value": "3"
    }
  ],
  "item": [
    {
      "name": "Autenticación (contraseña en variable local demoPassword)",
      "item": [
        {
          "name": "Login encargado encargado@acordes.local",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('encargadoIdToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"encargado@acordes.local\",\n  \"clave\": \"{{demoPassword}}\",\n  \"tipoAcceso\": \"encargado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login estudiante carlos@acordes.local",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
